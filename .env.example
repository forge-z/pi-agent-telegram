# Nothing here is required to boot.
# `npm run setup` asks for the Telegram bot, text/image/audio models,
# and the MCP aggregators (Executor, Composio, both, or none) and stores
# them on the volume. Variables below are optional overrides: when set,
# they win over the volume. TZ is the container clock and is not stored
# by setup. Leave a line unset rather than filling in a personal value.

# TZ=UTC

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_ALLOWED_CHATS=

# EXECUTOR_MCP_URL=
# EXECUTOR_TOKEN=
# COMPOSIO_MCP_URL=
# COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=

# Sandbox. Empty until you set one. A machine id is used only when set
# here or in $DATA_DIR/config.yaml. With neither set, discovery uses a
# machine only when exactly one is running.
# INSTABOX_ACCOUNT_ID=
# INSTABOX_MACHINE_ID=
# INSTABOX_REPO_ALLOWLIST=

# Compat reserve only ("Other" in setup). Ignored when an official setup
# is already on the volume.
# LLM_BASE_URL=
# LLM_API_KEY=
