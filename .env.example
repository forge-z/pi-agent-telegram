# Server/Coolify runtime variables only. Never commit real values.
# Bot token + user allowlist are required. Chat allowlist defaults to the same IDs (private DM).
TELEGRAM_BOT_TOKEN=123456:replace_with_bot_token
TELEGRAM_ALLOWED_USERS=123456789
# Container clock, used by log timestamps. Schedules carry their own IANA timezone, so this
# never moves a cron. Omit for UTC.
# TZ=America/Sao_Paulo

# Optional: group/supergroup chat IDs (negative). Omit for DM-only (uses TELEGRAM_ALLOWED_USERS).
# TELEGRAM_ALLOWED_CHATS=-1001234567890

# One generic OpenAI-compatible provider. No model is pinned here: choose it in
# Telegram with /model and /thinking, or set the global default from the container
# terminal with `npm run setup-model`. Until a default is chosen, the first catalog
# entry is used and the bot warns once per conversation.
#
# The URL is the API root and is used verbatim: the adapter appends /chat/completions
# and the optional discovery appends /models. Copy the root as the provider documents it.
# OpenAI: https://api.openai.com/v1 · DeepSeek: https://api.deepseek.com
LLM_BASE_URL=https://llm.example/v1
LLM_API_KEY=replace_with_api_key
#
# Optional explicit catalog. Each entry is:
#   id
#   id|contextWindow|maxTokens|reasoning
# where reasoning is `false`, `true`, or the exact `+` separated level list the upstream
# model accepts. Discovery via GET /models cannot see capabilities, so without this,
# /thinking stays limited to "off".
# LLM_MODELS=chat-model,reasoning-model|65536|8192|true
# DeepSeek example (values from the pi-ai 1.3.0 catalog; /thinking then offers
# off/low/high/max, because DeepSeek rejects minimal and medium but supports max):
# LLM_MODELS=deepseek-flash|1000000|384000|off+low+high+max

# What the chat model accepts: "text,image" (default) or "text". Declare "text" for a
# text-only model, so an image goes to VISION_MODEL instead of reaching a blind model.
# LLM_INPUT=text
#
# Vision (optional). Empty VISION_MODEL means the chat model handles images; set it and
# the image is described by that model and injected as text. Always useful with
# LLM_INPUT=text. VISION_BASE_URL empty inherits LLM_BASE_URL, and VISION_API_KEY empty
# inherits LLM_API_KEY only when the endpoint is the same host - set the key otherwise.
# Gemini through its OpenAI-compatible surface:
#   VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_MODE=auto            # auto | native | text
# VISION_MODEL=
# VISION_BASE_URL=
# VISION_API_KEY=
#
# Audio (optional). Transcribes Telegram voice notes and admits the text as the turn.
# The model MUST accept OGG/Opus, which is the only format Telegram sends for a voice
# note: whisper-1, Gemini and Groq do; the gpt-4o-transcribe family does not list ogg
# and will fail. Empty AUDIO_MODEL disables audio. A chat endpoint does not transcribe,
# so AUDIO_BASE_URL defaults to OpenAI and AUDIO_API_KEY must be set - it inherits
# LLM_API_KEY only when AUDIO_BASE_URL is on the same host as the chat endpoint.
# AUDIO_MODEL=whisper-1
# AUDIO_API=openai            # openai (multipart) | gemini (inline base64 JSON)
# AUDIO_BASE_URL=https://api.openai.com/v1
# AUDIO_API_KEY=
# AUDIO_LANGUAGE=             # empty = detect
#
# `npm run setup` writes the provider, model, effort and the optional vision/audio
# backends into the volume; these variables are the declarative override and win when
# set. They are optional: leave them empty and use the wizard.
#
# Async jobs (optional). Tools that start a job which outlives the turn, as full paths
# separated by commas. The poller reads runs with the sibling "list_runs" of the same
# integration and wakes a turn in this chat/topic when the run finishes.
# ASYNC_JOB_TIMEOUT_MIN=30
# ASYNC_JOB_POLL_SECONDS=25
#
# Optional: overrides the account the built-in job manifest uses. Not needed — v2 binds it
# in the tool's own signature.
# EXECUTOR_ACCOUNT_ID=acc_...
#
# Async jobs are described by manifests: one JSON per job tool, and the core needs no
# provider knowledge. Full reference and migration notes: docs/jobs.md. Example:
#
# ASYNC_JOB_MANIFESTS=[{"tool":"tools.tinyfish.agent.automation.runAsync",
#   "dispatch":{"mode":"immediate"},
#   "observe":{"mode":"poll","tool":"tools.tinyfish.agent.runs.getRunById",
#     "args":{"accountId":"acc_...","input":{"path":{"id":"${id}"}}},
#     "statePath":"status","resultPath":"result","errorPath":"error"},
#   "dedupe":"job:${row}:${id}"}]
#
# dispatch.mode: immediate | deferred | opaque. observe.mode: poll | webhook | reconcile
# (reconcile needs observe.match, e.g. {"goal":"${goal}"}). States are matched
# case-insensitively against a default vocabulary (PENDING, RUNNING, COMPLETED, FAILED,
# CANCELLED, TIMED_OUT...) and anything unrecognized is "unknown", never a failure.
#
# Deprecated (removal 2026-12-31): a comma separated v1 path list, translated at startup.
# ASYNC_JOB_TOOLS=tinyfish_mcp.user.personalTinyfishMcp.run_web_automation

# Remote HTTP/SSE MCP (Executor). Point each deployment at self-hosted or cloud.
# EXECUTOR_MCP_URL builds the default single-server config when MCP_SERVERS_JSON is empty or [].
EXECUTOR_MCP_URL=https://executor.example/mcp
# EXECUTOR_TOKEN is the raw API key. The app adds Authorization: Bearer itself.
EXECUTOR_TOKEN=replace_with_api_key
# Optional: full MCP list (multiple servers). When set and not [], replaces EXECUTOR_MCP_URL.
# MCP_SERVERS_JSON=[{"name":"executor","url":"https://executor.example/mcp","tokenEnv":"EXECUTOR_TOKEN"}]
# Alternative mounted configuration:
# MCP_CONFIG_FILE=/app/config/mcp.json
# All API keys and the Telegram token accept NAME_FILE=/run/secrets/name.
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
