{
  "name": "pi-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-model.mjs",
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json && node scripts/write-build-info.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test --test-concurrency=2 test/*.test.ts",
    "diagnose": "node scripts/diagnose-tg-runtime.mjs",
    "setup-model": "node scripts/setup-model.mjs",
    "compose:up": "bash scripts/compose-up.sh"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cron-parser": "5.10.1",
    "marked": "18.1.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "zod": "^4.6.5"
  }
}
